# Copy this file to .env and fill in your values. Never put real keys in this file:
# .env.example is committed; .env is gitignored.

# --- Which model writes the answers ---
# gemini     -> Google Gemini (free tier available: https://aistudio.google.com/apikey)
# claude     -> Anthropic Claude (paid; best citations, uses Claude's native Citations API)
# extractive -> no LLM at all; answers are the best-matching passages, cited verbatim
CITEWISE_GENERATOR=gemini

# --- Gemini ---
GEMINI_API_KEY=
# CITEWISE_GEMINI_MODEL=gemini-flash-latest   # or pin one, e.g. gemini-2.5-flash

# --- Claude ---
ANTHROPIC_API_KEY=
# CITEWISE_ANTHROPIC_MODEL=claude-opus-5-5
# CITEWISE_ANTHROPIC_EFFORT=medium   # low | medium | high | xhigh | max

# --- Required in production ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
CITEWISE_JWT_SECRET=

# --- Optional (defaults shown) ---
# CITEWISE_ENV=development
# CITEWISE_DATABASE_URL=sqlite+aiosqlite:///./data/citewise.db
# CITEWISE_QDRANT_URL=            # empty -> embedded Qdrant in ./data/qdrant
# CITEWISE_STORAGE_BACKEND=local  # or s3 (set CITEWISE_S3_BUCKET, CITEWISE_S3_ENDPOINT_URL, AWS_* creds)
# CITEWISE_MAX_UPLOAD_MB=25
# CITEWISE_EMBEDDING_BACKEND=fastembed
# CITEWISE_DENSE_MODEL=BAAI/bge-small-en-v1.5
# CITEWISE_WORKER_CONCURRENCY=2
# CITEWISE_CORS_ORIGINS=["http://localhost:8000"]
